#showFreePlayAccordion
    .form-group
        label(for='showFreePlayGlobal') Global (arcade-wide free play):
        .btn-group-toggle(data-toggle='buttons' onclick='setFreeplay("/set/arcade/freeplay/"); return false;')
            label.btn.btn-lg.w-100.freeplay(class=`${(arcade) ? 'active' : ''}`)
                if (arcade)
                    input#showFreePlayGlobal(type='checkbox' checked='' autocomplete='off')
                else
                    input#showFreePlayGlobal(type='checkbox' autocomplete='off')
                i.fas.fa-circle-check
    p.small.text-muted.mb-0 Per-machine prices &amp; free play are in #[strong Tools → Prices].
